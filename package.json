{
  "name": "squash-linares",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:setup": "node --env-file=.env.local scripts/db-setup.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "test:workflow": "node --env-file=.env.local scripts/test-workflow.mjs",
    "test:mobile": "node --env-file=.env.local scripts/test-workflow.mjs --browser"
  },
  "dependencies": {
    "next": "^16.4.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
